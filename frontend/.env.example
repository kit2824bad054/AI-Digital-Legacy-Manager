# ============================================================
# AI DIGITAL LEGACY MANAGER - FRONTEND ENVIRONMENT VARIABLES
# ============================================================
# NOTE: All frontend variables in Vite must start with VITE_
# IMPORTANT: Never place secret API keys (like Gemini or JWT) here!
# ============================================================

# Backend API Base URL
# In local development with Vite proxy, you can use empty string or http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Application Name
VITE_APP_TITLE=AI Digital Legacy Manager
