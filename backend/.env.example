# ============================================================
# AI DIGITAL LEGACY MANAGER - BACKEND ENVIRONMENT VARIABLES
# ============================================================
# NOTE: Replace placeholder values with your real credentials.
# Do NOT commit this file with real credentials to GitHub.
# ============================================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Allowed Frontend URL for CORS (Vite default is http://localhost:5173)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/digital_legacy_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/digital_legacy_db?retryWrites=true&w=majority

# JSON Web Token (JWT) Secret Key for Authentication
JWT_SECRET=legacy_guardian_ultra_secure_jwt_secret_key_2026_xyz987

# JWT Expiration Time
JWT_EXPIRES_IN=7d

# Google Gemini API Key (gemini-2.5-flash)
# Used on backend only to analyze letters, extract will data, and generate personality snapshots
GEMINI_API_KEY=your_gemini_api_key_here
